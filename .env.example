# Central AI Micro-Business Operating System
# Environment Configuration

# Application
NEXT_PUBLIC_APP_NAME="Central AI Micro-Business OS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# AI Provider API Keys (Optional)
# If left empty, Central AI operates in clearly marked "Sample AI response" mode
# with schema-valid, evidence-grounded pre-computed answers over synthetic demo data.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Database Configuration (Optional for PostgreSQL)
# Default is local file-backed persistence for instant zero-dependency hackathon setup
DATABASE_URL="file:./dev.db"

# Security & Sessions
SESSION_SECRET="demo-secret-key-change-in-production-min-32-chars-long"

# Feature Flags
# NOTICE: Live funding and real payment solicitation are strictly BLOCKED in this release.
FEATURE_LIVE_FUNDING="BLOCKED"
FEATURE_SAMPLE_AI_MODE="true"
